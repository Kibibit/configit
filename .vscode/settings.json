{
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.rulers": [120],
  "editor.matchBrackets": "always",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs":"active",
  "debug.javascript.autoAttachFilter": "onlyWithFlag",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.format.enable": true,
  "bracketPairColorizer.colorMode": "Consecutive",
  "bracketPairColorizer.forceUniqueOpeningColor": true,
  "bracketPairColorizer.showBracketsInGutter": true,
  "window.title": "${activeEditorShort}${separator}${rootName} [kibibit]",
  "debug.javascript.terminalOptions": {
    "skipFiles": [
      "<node_internals>/**"
    ]
  },
  "svg.preview.background": "black",
  "todotodohighlight.isEnable": true,
  "todohighlight.keywordsPattern": "TODO(@\\w+?)?:",
  "todohighlight.defaultStyle": {
    "color": "black",
    "backgroundColor": "rgba(255, 221, 87, .8)",
    "overviewRulerColor": "rgba(255, 221, 87, .8)",
    "fontWeight": "bold",
    "borderRadius": "2px",
    "isWholeLine": true,
  },
  "conventionalCommits.scopes": [
    "security"
  ],
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#af5598",
    "activityBar.background": "#af5598",
    "activityBar.foreground": "#e7e7e7",
    "activityBar.inactiveForeground": "#e7e7e799",
    "activityBarBadge.background": "#a3b867",
    "activityBarBadge.foreground": "#15202b",
    "commandCenter.border": "#e7e7e799",
    "sash.hoverBorder": "#af5598",
    "statusBar.background": "#8e437b",
    "statusBar.foreground": "#e7e7e7",
    "statusBarItem.hoverBackground": "#af5598",
    "statusBarItem.remoteBackground": "#8e437b",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "titleBar.activeBackground": "#8e437b",
    "titleBar.activeForeground": "#e7e7e7",
    "titleBar.inactiveBackground": "#8e437b99",
    "titleBar.inactiveForeground": "#e7e7e799"
  },
  "peacock.color": "#8e437b"
}